{
    "name": "@velociti/sdk",
    "version": "0.2.0",
    "description": "Official SDK for deploying and managing tokens on VELOCITI - the Solana tax token launchpad",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "velociti": "./dist/cli.js"
    },
    "scripts": {
        "build": "tsc",
        "test": "jest",
        "prepublishOnly": "npm run build",
        "docs": "typedoc --out docs/api src/index.ts"
    },
    "keywords": [
        "solana",
        "token",
        "launchpad",
        "velociti",
        "tax-token",
        "token-2022",
        "ai-agent",
        "cli",
        "sdk"
    ],
    "author": "VELOCITI",
    "license": "MIT",
    "dependencies": {
        "@solana/web3.js": "^1.95.0"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "typedoc": "^0.25.0",
        "typescript": "^5.3.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Velociti-Launchpad/velociti-sdk"
    },
    "homepage": "https://velociti.fun/developers",
    "bugs": {
        "url": "https://github.com/Velociti-Launchpad/velociti-sdk/issues"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=18.0.0"
    }
}